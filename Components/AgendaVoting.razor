@using TwilightImperiumRoller.Models

@if (IsAdmin && ActiveVote is null)
{
  <div class="d-flex justify-content-end m-2">
    <RadzenButton Click="OnStartVoteClick">Start Agenda Vote</RadzenButton>
  </div>
}

<div class="popout @setupOverlayVisible glow" style="width: fit-content;">
  <div class="d-flex flex-column justify-content-evenly m-2 p-2">
    <h2>Start Agenda Vote</h2>
    Agenda Name:
    <RadzenAutoComplete Data="@AgendaNameSuggestions" @bind-Value="agendaNameInput" Change="@OnAgendaNameChanged" Placeholder="Start typing an agenda name..." />
    Elect (if applicable):
    <RadzenTextBox @bind-Value="electInput"></RadzenTextBox>
    Effect:
    <RadzenTextBox @bind-Value="effectInput"></RadzenTextBox>
    <h4>Outcomes</h4>
    @foreach (OutcomeRow row in outcomeRows)
    {
      <div class="d-flex flex-row gap-2 align-items-center" @key="row.Id">
        <RadzenTextBox @bind-Value="row.Label"></RadzenTextBox>
        <RadzenIcon Icon="Close" IconColor="@Colors.Warning" onclick="@(() => RemoveOutcomeRow(row.Id))"></RadzenIcon>
      </div>
    }
    <div class="d-flex flex-row gap-2">
      <RadzenButton Click="AddOutcomeRow">Add outcome</RadzenButton>
      <RadzenButton Click="OnConfirmStartVote">Start Vote</RadzenButton>
    </div>
  </div>
</div>
<div class="overlay @setupOverlayVisible" @onclick="@HideSetupOverlay" />

@if (ActiveVote is not null)
{
  AgendaVote vote = ActiveVote;
  <div class="popout glow" style="width: fit-content;">
    <div class="d-flex flex-column justify-content-evenly m-2 p-2">
      <h2>Voting: @vote.AgendaName</h2>
      @if (!string.IsNullOrWhiteSpace(vote.Elect))
      {
        <div><strong>Elect:</strong> @vote.Elect</div>
      }
      @if (!string.IsNullOrWhiteSpace(vote.Effect))
      {
        <div>@vote.Effect</div>
      }
      <div class="d-flex flex-column gap-2 mt-2">
        @foreach (AgendaVoteOutcome outcome in vote.Outcomes)
        {
          <div class="d-flex flex-row align-items-center gap-2" @key="outcome.Id">
            <div style="min-width:150px;"><strong>@outcome.Label</strong> — Total: @outcome.Contributions.Values.Sum()</div>
            <RadzenNumeric TValue="int" Value="@GetPendingAmount(outcome.Id)" ValueChanged="@(v => SetPendingAmount(outcome.Id, v))" />
            <RadzenButton Click="@(() => OnCastVote(outcome.Id))">Vote</RadzenButton>
          </div>
        }
      </div>
      @if (!string.IsNullOrWhiteSpace(vote.Elect))
      {
        <div class="d-flex flex-row gap-2 align-items-center mt-2">
          <RadzenTextBox @bind-Value="newOutcomeLabelInput" Placeholder="Add an outcome (e.g. a player name)..."></RadzenTextBox>
          <RadzenButton Click="OnAddVoteOutcome">Add Outcome</RadzenButton>
        </div>
      }
      @if (IsAdmin)
      {
        <div class="mt-3">
          <RadzenButton Click="OnStopVote" ButtonStyle="ButtonStyle.Danger">Stop Voting</RadzenButton>
        </div>
      }
    </div>
  </div>
  <div class="overlay" />
}
